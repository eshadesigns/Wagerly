# Backend-only Supabase project configuration (the public anon/publishable key).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Keep this key on the server. Never add a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Authentication endpoint limits (per IP, per AUTH_RATE_LIMIT_WINDOW_MS).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=10
AUTH_VERIFY_EMAIL_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=10

# Optional Supabase integration tests: use a dedicated test project only.
# Email confirmation must be disabled for test signups. Cleanup deletes only
# auth users created by that test run, and requires explicit opt-in.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_DB_URL=
SUPABASE_TEST_PROJECT_REF=
SUPABASE_TEST_ALLOW_CLEANUP=false
