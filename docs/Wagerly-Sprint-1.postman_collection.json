{
  "info": {
    "_postman_id": "d44d2fcb-84c7-41bc-9d0b-f2fab24a0ef2",
    "name": "Wagerly Sprint 1 API",
    "description": "Signup, email confirmation, login, refresh, goal creation, Gemini task generation, and task retrieval. Set the collection variables before running. Copy the token_hash from the Supabase confirmation link into confirmationTokenHash.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "confirmationTokenHash", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "goalId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "1. Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('email')) {",
              "  pm.collectionVariables.set('email', 'wagerly-demo-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "2. Verify email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tokenHash\": \"{{confirmationTokenHash}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/verify-email"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "if (response.session) {",
              "  pm.collectionVariables.set('accessToken', response.session.access_token);",
              "  pm.collectionVariables.set('refreshToken', response.session.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "if (response.session) {",
              "  pm.collectionVariables.set('accessToken', response.session.access_token);",
              "  pm.collectionVariables.set('refreshToken', response.session.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Refresh session",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "if (response.session) {",
              "  pm.collectionVariables.set('accessToken', response.session.access_token);",
              "  pm.collectionVariables.set('refreshToken', response.session.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Create goal",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Build a daily reading habit\",\n  \"description\": \"Read for at least 15 minutes each day.\",\n  \"deadline\": \"2027-01-31\"\n}"
        },
        "url": "{{baseUrl}}/api/goals"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "if (response.goal) {",
              "  pm.collectionVariables.set('goalId', response.goal.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Generate tasks",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/goals/{{goalId}}/tasks/generate"
      }
    },
    {
      "name": "7. Retrieve saved tasks",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/goals/{{goalId}}/tasks"
      }
    }
  ]
}
